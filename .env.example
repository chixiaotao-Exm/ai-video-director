# Paths, relative to the directory where the application is launched.
AVD_DATA_DIR=./data
# Omit to derive SQLite state.db under AVD_DATA_DIR.
# AVD_DATABASE_URL=sqlite:///data/state.db

# ComfyUI profiles: JSON object or nested __ variables supported.
AVD_COMFYUI_ACTIVE_PROFILE=local
AVD_COMFYUI_PROFILES={"local":{"base_url":"http://127.0.0.1:8188","timeout":60},"remote":{"base_url":"http://127.0.0.1:8189","timeout":60}}
# Manual ComfyUI smoke only (not read by normal queue workers).
# AVD_COMFYUI_URL=http://127.0.0.1:8188
# AVD_SMOKE_WORKFLOW=workflows/exported_api.json

# LLM roles: defaults requested by the milestone specification; model availability
# depends on the provider or relay account. Set Gemini explicitly before analysis.
AVD_DIRECTOR_MODEL=claude-opus-5-5
AVD_SCRIPT_MODEL=gpt-6.1-sol
AVD_QA_MODEL=gpt-6.1-sol
AVD_IMAGE_MODEL=gpt-image-2
# AVD_GEMINI_MODEL=your-enabled-gemini-model
# AVD_ANTHROPIC_API_KEY=
# AVD_OPENAI_API_KEY=
# AVD_GEMINI_API_KEY=
# AVD_ANTHROPIC_BASE_URL=
# AVD_OPENAI_BASE_URL=
# AVD_GEMINI_BASE_URL=
# Optional role routing override: {"role":{"provider":"...","model":"..."}}
AVD_LLM_ROUTES={}
# Prices in USD per million tokens; unknown prices warn and record zero.
# Keys can be "provider/model" or model name. Populate with your relay's prices.
AVD_MODEL_PRICES={}
AVD_CONFIRM_THRESHOLD=1.0
# Maximum generated tokens per LLM response (also used in pre-call estimates).
AVD_LLM_MAX_OUTPUT_TOKENS=4096

# Analysis uses CPU/int8 Whisper by default; the model downloads only on a live call.
AVD_WHISPER_MODEL=small

# Real exported ComfyUI workflow directory; omit for shipped placeholder contracts.
# AVD_WORKFLOW_DIR=./workflows
# Conservative flat estimates per executor job, for preflight budget checks.
AVD_JOB_ESTIMATED_COSTS={}
# Manual paid image smoke: explicit prompt and optional relative/local reference.
# AVD_SMOKE_IMAGE_PROMPT=A character reference sheet
# AVD_SMOKE_IMAGE_REFERENCE=./data/assets/characters/example/front.png
# Manual FFmpeg smoke input (no network).
# AVD_SMOKE_MEDIA_VIDEO=./data/example.mp4
# Upload stream limit (bytes), default 200 MiB.
AVD_MAX_UPLOAD_BYTES=209715200

# GPU installer variables are read by deploy/gpu-server/setup.sh from its shell.
# Export them on the rented host; they are not application Settings.
# COMFYUI_DIR=/home/ubuntu/ComfyUI
# COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
# COMFYUI_REF=your-verified-revision
# COMFYUI_PORT=8188
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# CUSTOM_NODES=https://github.com/OWNER/NODE.git
# MODELS_MANIFEST=/path/to/deploy/gpu-server/models.yaml
# HF_TOKEN=
# SERVICE_MODE=auto
# DRY_RUN=1

# T15 model download profiles for GPU setup (shell export, not application Settings).
# Default none performs no model downloads. All opt-in tiers share the reviewed baseline.
# MODEL_PROFILE=none
# Choices: none, draft12 (12 GB), balanced24 (24 GB), quality48 (48 GB).
# These are planning tiers; see docs/MODELS.md for memory, license and node caveats.

# Observability: logs use stderr; API/worker events carry project/job IDs.
AVD_LOG_FORMAT=text
AVD_LOG_LEVEL=INFO
# Hard process deadline in seconds; job-type values override the default.
AVD_JOB_TIMEOUT_SECONDS=3600
AVD_JOB_TIMEOUTS={"image_to_video":3600,"tts":600,"lipsync":1800}
# SIGINT/SIGTERM stops claiming; finish current work within this grace, then terminate it.
AVD_WORKER_SHUTDOWN_GRACE_SECONDS=30
# Optional shell-only interpreter fallback for scripts/check.sh (the local venv wins).
# PYTHON=python3

# Initial budget for projects created without an explicit limit. Zero means no spending.
AVD_DEFAULT_BUDGET_LIMIT=0
