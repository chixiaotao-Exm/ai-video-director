# Paths, relative to the directory where the application is launched.
AVD_DATA_DIR=./data
# Omit to derive SQLite state.db under AVD_DATA_DIR.
# AVD_DATABASE_URL=sqlite:///data/state.db

# ComfyUI profiles: JSON object or nested __ variables supported.
AVD_COMFYUI_ACTIVE_PROFILE=local
AVD_COMFYUI_PROFILES={"local":{"base_url":"http://127.0.0.1:8188","timeout":60},"remote":{"base_url":"http://127.0.0.1:8189","timeout":60}}
# Manual ComfyUI smoke only (not read by normal queue workers).
# AVD_COMFYUI_URL=http://127.0.0.1:8188
# AVD_SMOKE_WORKFLOW=workflows/exported_api.json

# LLM roles: defaults requested by the milestone specification; model availability
# depends on the provider or relay account. Set Gemini explicitly before analysis.
AVD_DIRECTOR_MODEL=claude-opus-5-5
AVD_SCRIPT_MODEL=gpt-6.1-sol
AVD_QA_MODEL=gpt-6.1-sol
AVD_IMAGE_MODEL=gpt-image-2
# AVD_GEMINI_MODEL=your-enabled-gemini-model
# AVD_ANTHROPIC_API_KEY=
# AVD_OPENAI_API_KEY=
# AVD_GEMINI_API_KEY=
# AVD_ANTHROPIC_BASE_URL=
# AVD_OPENAI_BASE_URL=
# AVD_GEMINI_BASE_URL=
# Optional role routing override: {"role":{"provider":"...","model":"..."}}
AVD_LLM_ROUTES={}
# Prices in USD per million tokens; unknown prices warn and record zero.
# Keys can be "provider/model" or model name. Populate with your relay's prices.
AVD_MODEL_PRICES={}
AVD_CONFIRM_THRESHOLD=1.0
# Maximum generated tokens per LLM response (also used in pre-call estimates).
AVD_LLM_MAX_OUTPUT_TOKENS=4096

# Analysis uses CPU/int8 Whisper by default; the model downloads only on a live call.
AVD_WHISPER_MODEL=small
